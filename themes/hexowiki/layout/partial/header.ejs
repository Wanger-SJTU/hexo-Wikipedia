<%
  const _theme = (typeof themeCfg !== 'undefined' && themeCfg) ? themeCfg : ((typeof theme !== 'undefined' && theme) ? theme : {});
  const _brand = (typeof brand !== 'undefined' && brand) ? brand : (_theme.brand || {});
  const _features = _theme.features || {};
  const _siteTitle = (typeof siteTitle !== 'undefined' && siteTitle) ? siteTitle : (_brand.title || (typeof config !== 'undefined' && config.title) || 'HexWiki');
  const _tagline = _brand.tagline || (typeof config !== 'undefined' && config.subtitle) || '';
  const _searchEnabled = _features.search !== false;
  const _sub = __('site_sub', _siteTitle);
  const _urls = (typeof wiki_urls === 'function') ? (wiki_urls() || {}) : {};
  const _graphUrl = _urls.graph || url_for('/graph/');
  const _statsUrl = _urls.stats || url_for('/stats/');
  const _allUrl = _urls.all || url_for('/wiki/all/');
  const _searchJson = _urls.search_json || url_for('/wiki-search.json');
  const _docsData = (typeof site !== 'undefined' && site && site.data && site.data.collections) ? site.data.collections : null;
  const _docsMode = !!(_theme.docs && _theme.docs.enable && _docsData && _docsData.count);
  const _docsUrl = url_for((_theme.docs && _theme.docs.url) || '/collections/');
%>
<header class="wiki-header" role="banner">
  <button class="menu-toggle" type="button" data-menu-toggle aria-controls="wiki-sidebar" aria-expanded="false" aria-label="<%= __('menu_open') %>" title="<%= __('menu_open') %>" data-label-open="<%= __('menu_open') %>" data-label-close="<%= __('menu_close') %>">
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M2.5 5h15M2.5 10h15M2.5 15h15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  </button>

  <a class="wiki-header__brand" href="<%- url_for('/') %>" title="<%= _sub %>" aria-label="<%= _siteTitle %> — <%= _sub %>">
    <span class="wiki-header__logo" aria-hidden="true">
      <svg width="38" height="38" viewBox="0 0 48 48" focusable="false">
        <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="2" opacity="0.75"/>
        <ellipse cx="24" cy="24" rx="9.5" ry="21" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.55"/>
        <ellipse cx="24" cy="24" rx="21" ry="8.5" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.55"/>
        <path d="M3.6 18h40.8M3.6 30h40.8" fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.55"/>
        <circle cx="24" cy="24" r="10" fill="var(--bg, #fff)" stroke="var(--link, #3366cc)" stroke-width="1.6"/>
        <text x="24" y="29.6" font-family="Georgia, 'Times New Roman', serif" font-size="15" font-weight="600" fill="currentColor" text-anchor="middle">W</text>
      </svg>
    </span>
    <span class="wiki-header__wordmark">
      <span class="wiki-header__title"><%- _siteTitle %></span>
      <% if (_tagline) { %><span class="wiki-header__tagline"><%- _tagline %></span><% } %>
    </span>
  </a>

  <% if (_searchEnabled) { %>
  <form class="wiki-search" role="search" action="<%- _docsMode ? _docsUrl : _allUrl %>" method="get" data-search-form data-src="<%- _searchJson %>" data-limit="<%- (_theme.search && _theme.search.limit) || 8 %>">
    <label class="visually-hidden" for="wiki-search-input"><%= __('search_label') %></label>
    <svg class="wiki-search__icon" width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <path d="m12.8 12.8 4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
    <input class="wiki-search__input" id="wiki-search-input" type="search" name="q" placeholder="<%= __('search_placeholder') %>" autocomplete="off" spellcheck="false"
      aria-label="<%= __('search_label') %>" aria-autocomplete="list" aria-controls="search-suggest" aria-expanded="false" role="combobox">
    <kbd class="wiki-search__kbd" aria-hidden="true">/</kbd>
    <button class="wiki-search__button" type="submit">
      <span class="wiki-search__button-text"><%= __('search_button') %></span>
    </button>
    <div class="search-suggest" id="search-suggest" role="listbox" aria-label="<%= __('search_label') %>" data-empty="<%= __('search_empty') %>" data-loading="<%= __('search_loading') %>" hidden></div>
  </form>
  <% } else { %><div class="wiki-header__spacer" aria-hidden="true"></div><% } %>

  <nav class="wiki-header__nav" aria-label="<%= __('sidebar_tools') %>">
    <% if (_docsMode) { %>
    <a class="wiki-header__link" href="<%- _docsUrl %>">文档库</a>
    <a class="wiki-header__link" href="<%- url_for('/tags/') %>">标签</a>
    <% } %>
    <% if (!_docsMode && _features.random !== false) { %>
    <a class="wiki-header__link js-random" href="<%- _allUrl %>" data-random-src="<%- _searchJson %>"><%= __('random_page') %></a>
    <% } %>
    <% if (!_docsMode && _features.stats !== false) { %>
    <a class="wiki-header__link" href="<%- _statsUrl %>"><%= __('statistics') %></a>
    <% } %>
    <% if (!_docsMode && _features.graph !== false) { %>
    <a class="wiki-header__link" href="<%- _graphUrl %>"><%= __('graph') %></a>
    <% } %>
    <% if (_features.dark_mode !== false) { %>
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="<%= __('theme_toggle') %>" title="<%= __('theme_toggle') %>" data-label-light="<%= __('light_mode') %>" data-label-dark="<%= __('dark_mode') %>">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7"/>
        <path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.3 8.3 0 1 0 10.2 10.2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      </svg>
    </button>
    <% } %>
  </nav>
</header>
