<%
  const _theme = (typeof themeCfg !== 'undefined' && themeCfg) ? themeCfg : ((typeof theme !== 'undefined' && theme) ? theme : {});
  const _navCfg = (typeof navCfg !== 'undefined' && navCfg) ? navCfg : (_theme.nav || {});
  const _showBadges = _navCfg.show_badges !== false;
  let _nav = [];
  if (typeof wiki_nav === 'function') {
    try { _nav = wiki_nav() || []; } catch (err) { _nav = []; }
  }
  const _docsData = (typeof site !== 'undefined' && site && site.data && site.data.collections) ? site.data.collections : null;
  const _docsUrl = url_for((_theme.docs && _theme.docs.url) || '/collections/');
  const _esc = function (value) {
    return String(value === undefined || value === null ? '' : value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  };
  let _seq = 0;
  const _children = function (nodes, depth) {
    if (!nodes || !nodes.length) return '';
    return '<ul class="nav-tree__list" data-depth="' + depth + '">' + nodes.map(function (node) {
      if (!node) return '';
      if (node.type === 'group' || (!node.url && node.children)) {
        const key = node.key || ('group-' + (depth) + '-' + (node.label || node.title || (_seq++)));
        const id = 'nav-children-' + (_seq++);
        const open = !!node.open || (depth === 0 && _navCfg.open_first_level !== false);
        const hasActive = !!(node.active || (node.children || []).some(function (child) { return child && child.active; }));
        return '<li class="nav-tree__item nav-tree__group' + (open ? ' is-open' : '') + (hasActive ? ' has-active' : '') + '" data-nav-type="group">'
          + '<button class="nav-tree__toggle" type="button" aria-expanded="' + (open ? 'true' : 'false') + '" aria-controls="' + id + '" data-nav-key="' + _esc(key) + '">'
          + '<svg class="nav-tree__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 3.25 5 6.25 8 3.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
          + '<span class="nav-tree__label">' + _esc(node.label || node.title || '') + '</span>'
          + '</button>'
          + '<div class="nav-tree__children" id="' + id + '"' + (open ? '' : ' hidden') + '>' + _children(node.children || [], depth + 1) + '</div>'
          + '</li>';
      }
      const url = node.url || '#';
      const active = !!node.active;
      const badge = (_showBadges && node.backlinks) ? '<span class="nav-tree__badge" title="' + _esc(__('backlinks') + ': ' + node.backlinks) + '">' + _esc(node.backlinks) + '</span>' : '';
      return '<li class="nav-tree__item" data-nav-type="page">'
        + '<a class="nav-tree__link' + (active ? ' is-active' : '') + '" href="' + _esc(url) + '"' + (active ? ' aria-current="page"' : '') + '>'
        + '<span class="nav-tree__link-text">' + _esc(node.label || node.title || '') + '</span>' + badge + '</a>'
        + '</li>';
    }).join('') + '</ul>';
  };
  const _treeHtml = _children(_nav, 0);
  let _docSeq = 0;
  const _docTree = (_docsData && _docsData.tree && _docsData.tree.length)
    ? _docsData.tree
    : ((_docsData && _docsData.groups) || []).map(function (group) {
        return { name: group.name, url: _docsUrl, count: group.count, children: [] };
      });
  const _docMaxDepth = 2; // 侧栏只展开两级，更深层进入目录页
  const _docTreeHtml = function (nodes, depth) {
    if (!nodes || !nodes.length) return '';
    return nodes.map(function (node) {
      const hasChildren = !!(node.children && node.children.length);
      const canExpand = hasChildren && depth < _docMaxDepth;
      const id = 'docs-children-' + (_docSeq++);
      const open = depth === 0 && _navCfg.open_first_level !== false;
      const chevron = '<svg class="nav-tree__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M2 3.25 5 6.25 8 3.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      return '<li class="nav-tree__item nav-tree__group' + (open ? ' is-open' : '') + '" data-nav-type="group">'
        + '<div class="nav-tree__docs-head">'
        + (canExpand
            ? '<button class="nav-tree__toggle" type="button" aria-expanded="' + (open ? 'true' : 'false') + '" aria-controls="' + id + '" data-nav-key="doc:' + _esc(node.path) + '">' + chevron + '</button>'
            : '<span class="nav-tree__toggle-spacer" aria-hidden="true"></span>')
        + '<a class="nav-tree__link" href="' + _esc(node.url) + '">'
        + '<span class="nav-tree__link-text">' + _esc(node.name) + '</span>'
        + '<span class="nav-tree__badge">' + _esc(node.count) + '</span>'
        + '</a>'
        + '</div>'
        + (canExpand
            ? '<div class="nav-tree__children" id="' + id + '"' + (open ? '' : ' hidden') + '><ul class="nav-tree__list" data-depth="' + (depth + 1) + '">' + _docTreeHtml(node.children, depth + 1) + '</ul></div>'
            : '')
        + '</li>';
    }).join('');
  };
%>
<% if ((!_nav || !_nav.length) && !(_docsData && _docsData.count)) { %>
<p class="nav-tree__empty"><%= __('sidebar_empty') %></p>
<% } else if (!_nav || !_nav.length) { %>
<div class="nav-tree" data-nav-tree>
  <ul class="nav-tree__list" data-depth="0">
    <li class="nav-tree__item" data-nav-type="page">
      <a class="nav-tree__link" href="<%- _docsUrl %>">
        <span class="nav-tree__link-text">文档库</span>
        <span class="nav-tree__badge"><%- _docsData.count %></span>
      </a>
    </li>
    <%- _docTreeHtml(_docTree, 0) %>
  </ul>
</div>
<% } else { %>
<div class="nav-tree" data-nav-tree>
  <%- _treeHtml %>
</div>
<% } %>
