<%
  const _theme = (typeof themeCfg !== 'undefined' && themeCfg) ? themeCfg : ((typeof theme !== 'undefined' && theme) ? theme : {});
  const _layout = (typeof page !== 'undefined' && page && page.layout) ? page.layout : 'page';
%>
<script src="<%- url_for('/js/app.js') %><%- (theme.assets && theme.assets.version) ? ('?v=' + theme.assets.version) : '' %>" defer></script>
<% if (_layout === 'wiki_graph' || _layout === 'post') { %>
<script src="<%- url_for('/js/graph.js') %><%- (theme.assets && theme.assets.version) ? ('?v=' + theme.assets.version) : '' %>" defer></script>
<% } %>
<%
  const _mathContent = (typeof page !== 'undefined' && page && page.content) ? String(page.content) : '';
  const _hasMath = /(\$\$[\s\S]{1,6000}?\$\$|\$[^$\n]{1,300}\$|\\\(|\\\[|\\begin\{(equation|align|array|matrix|pmatrix|bmatrix|cases|split)\})/.test(_mathContent);
  const _mathEnabled = !(theme.math && theme.math.enable === false);
%>
<% if (_hasMath && _mathEnabled) { %>
<script src="<%- url_for('/vendor/katex/katex.min.js') %><%- (theme.assets && theme.assets.version) ? ('?v=' + theme.assets.version) : '' %>" defer></script>
<script src="<%- url_for('/vendor/katex/auto-render.min.js') %><%- (theme.assets && theme.assets.version) ? ('?v=' + theme.assets.version) : '' %>" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.renderMathInElement) return;
    var target = document.querySelector('.article__content') || document.querySelector('#wiki-main');
    if (!target) return;
    try {
      renderMathInElement(target, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '\\[', right: '\\]', display: true },
          { left: '$', right: '$', display: false },
          { left: '\\(', right: '\\)', display: false }
        ],
        throwOnError: false,
        strict: false,
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code', 'option']
      });
    } catch (err) { /* 公式渲染失败不影响阅读 */ }
  });
</script>
<% } %>
